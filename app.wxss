}

.mt-3 {
  margin-top: 12rpx;
}

.mt-4 {
  margin-top: 16rpx;
}

.mt-5 {
  margin-top: 20rpx;
}

.mt-6 {
  margin-top: 24rpx;
}

.mb-1 {
  margin-bottom: 4rpx;
}

.mb-2 {
  margin-bottom: 8rpx;
}

.mb-3 {
  margin-bottom: 12rpx;
}

.mb-4 {
  margin-bottom: 16rpx;
}

.mb-5 {
  margin-bottom: 20rpx;
}

.mb-6 {
  margin-bottom: 24rpx;
}

.ml-1 {
  margin-left: 4rpx;
}

.ml-2 {
  margin-left: 8rpx;
}

.ml-3 {
  margin-left: 12rpx;
}

.ml-4 {
  margin-left: 16rpx;
}

.ml-5 {
  margin-left: 20rpx;
}

.ml-6 {
  margin-left: 24rpx;
}

.ml-7 {
  margin-left: 30rpx;
}

.mr-1 {
  margin-right: 4rpx;
}

.mr-2 {
  margin-right: 8rpx;
}

.mr-3 {
  margin-right: 12rpx;
}

.mr-4 {
  margin-right: 16rpx;
}

.mr-5 {
  margin-right: 20rpx;
}

.mr-6 {
  margin-right: 24rpx;
}

/* 常用文本样式 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.font-bold {
  font-weight: bold;
}

.font-semibold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

.text-xs {
  font-size: 24rpx;
}

.text-sm {
  font-size: 28rpx;
}

.text-base {
  font-size: 32rpx;
}

.text-lg {
  font-size: 36rpx;
}

.text-xl {
  font-size: 40rpx;
}

.text-primary {
  color: #1f2937;
}

.text-secondary {
  color: #6b7280;
}

.text-tertiary {
  color: #9ca3af;
}

.text-purple-500 {
  color: #8b5cf6;
}

.text-green-600 {
  color: #16a34a;
}

.text-red-500 {
  color: #ef4444;
}

.text-blue-500 {
  color: #3b82f6;
}

.text-gray-500 {
  color: #6b7280;
}

/* 常用背景样式 */
.bg-primary {
  background-color: #ffffff;
}

.bg-secondary {
  background-color: #f9fafb;
}

.bg-tertiary {
  background-color: #f3f4f6;
}

.bg-gray-200 {
  background-color: #f8f8f8;
}

.bg-gray-400 {
  background-color: #6b7280;
}

.bg-green-600 {
  background-color: #16a34a;
}

.bg-purple-100 {
  background-color: #F3E8FF;
}

/* 常用边框样式 */
.border {
  border: 1rpx solid #e5e7eb;
}

.border-t {
  border-top: 1rpx solid #e5e7eb;
}

.border-b {
  border-bottom: 1rpx solid #e5e7eb;
}

.border-l {
  border-left: 1rpx solid #e5e7eb;
}

.border-r {
  border-right: 1rpx solid #e5e7eb;
}

.border-purple-500 {
  border-color: #8b5cf6;
}

.no-border {
  border: none;
}

/* 圆角样式 */
.rounded {
  border-radius: 8rpx;
}

.rounded-lg {
  border-radius: 16rpx;
}

.rounded-full {
  border-radius: 9999rpx;
}

/* 阴影样式 */
.shadow-sm {
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}

.shadow {
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.shadow-lg {
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.shadow-xl {
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 弹性布局 */
.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.items-start {
  align-items: flex-start;
}

.items-end {
  align-items: flex-end;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-around {
  justify-content: space-around;
}

.flex-1 {
  flex: 1;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.overflow-hidden {
  overflow: hidden;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

.w-8 {
  width: 64rpx;
}

.h-8 {
  height: 64rpx;
}

.w-16 {
  width: 4rem;
}

.h-16 {
  height: 4rem;
}

/* 按钮通用样式 */
.btn {
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #8b5cf6;
  color: white;
}

.btn-primary:active {
  background-color: #7c3aed;
  transform: scale(0.98);
}

.btn-secondary {
  background-color: #10b981;
  color: white;
}

.btn-secondary:active {
  background-color: #059669;
  transform: scale(0.98);
}

/* 输入框样式 */
.input {
  padding: 20rpx 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 32rpx;
  background-color: white;
}

.input:focus {
  border-color: #8b5cf6;
  outline: none;
}

/* 卡片样式 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 加载中样式 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 64rpx;
  color: #9ca3af;
}

.empty-state-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.fade-in {
  animation: fadeIn 0.3s ease-in;
}

/* 工具类 */
.hidden {
  display: none;
}

.opacity-0 {
  opacity: 0;
}

.cursor-pointer {
  cursor: pointer;
}

.user-select-none {
  user-select: none;
}