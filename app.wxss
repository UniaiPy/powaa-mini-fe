/* 全局样式 */
@import '/assets/font/css/font-awesome.min.wxss';

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #1f2937;
  line-height: 1.5;
}

/* 清除默认样式 */
view,
text,
image,
button,
input,
textarea,
navigator {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.gap-2 {
  display: grid;
  gap: 0.5rem;
}

/* 颜色常量 - 直接在样式中使用具体颜色值 */

.fixed {
  position: fixed;
}

.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.right-0 {
  right: 0;
}

.bottom-0 {
  bottom: 0;
}

.top-0 {
  top: 0;
}

/* 通用间距 */
.mt-1 {
