/* pages/fullscreen-map/fullscreen-map.wxss */
.container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* 位置信息面板 */
.location-info-panel {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  background: white;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.location-name {
  font-size: 18px;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8px;
  display: block;
}

.location-address {
  font-size: 14px;
  color: #6b7280;
  line-height: 1.4;
  display: block;
}