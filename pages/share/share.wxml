<!-- pages/share/share.wxml -->
<view class="page-container">
  <!-- 顶部导航 -->
  <!-- <view class="fixed-nav flex items-center justify-between py-3 px-6 text-black">
    <view class="flex items-center gap-3">
      <view class="cursor-pointer" bindtap="navigateBack">
        <text class="iconfont icon-chevron-left text-black text-lg"></text>
      </view>
    </view>
    <view class="text-xl font-bold text-gray-900">分享</view>
    <view class="w-6"></view>
  </view> -->
  <!-- 主要内容区域 -->
  <view class="content-with-fixed-nav flex-1 px-4 py-3 space-y-0">
    <view class="bg-white rounded-lg overflow-hidden">
      <!-- 分享方式 -->
      <view class="section-card">
        <view class="section-header">
          <view class="section-title">分享方式</view>
        </view>
        <view class="section-content" id="shareMethodContent">
          <!-- 微信相关分享方式 -->
          <view class="grid mb-4 mt-4">
            <!-- 微信好友 -->
            <button class="share-platform rounded-xl p-3 text-center" open-type="share">
              <view class="w-10 h-10 flex items-center justify-center mx-auto mb-2">
                <text class="fa fa-weixin text-xl text-green-600"></text>
              </view>
              <text class="text-xs text-gray-700">微信好友</text>
            </button>
            <!-- 微信群 -->
            <button class="share-platform rounded-xl p-3 text-center" open-type="share">
              <view class="w-10 h-10 flex items-center justify-center mx-auto mb-2">
                <text class="fa fa-users text-xl text-green-600"></text>
              </view>
              <text class="text-xs text-gray-700">微信群</text>
            </button>
            <!-- 朋友圈 -->
            <button class="share-platform rounded-xl p-3 text-center" data-platform="moments" bindtap="onSharePlatformTap">
              <view class="w-10 h-10 flex items-center justify-center mx-auto mb-2">
                <text class="fa fa-globe text-xl text-green-600"></text>
              </view>
              <text class="text-xs text-gray-700">朋友圈</text>
            </button>
          </view>
          <!-- 社交媒体分享方式 - 每行三列 -->
          <block wx:if="{{userSocialMedia.length > 0}}">
            <view class="grid mb-6">
              <button wx:for="{{userSocialMedia}}" wx:key="id" class="share-platform rounded-xl p-3 text-center" data-platform="social" data-id="{{item.id}}" bindtap="onSharePlatformTap">
                <view class="w-10 h-10 flex items-center justify-center mx-auto mb-2">
                  <image wx:if="{{item.icon}}" src="{{item.icon}}" class="social-icon" style="width: 24px; height: 24px;" mode="aspectFit"></image>
                  <text wx:else class="fa fa-link text-xl text-blue-500"></text>
                </view>
                <text class="text-xs text-gray-700">{{item.name}}</text>
              </button>
            </view>
          </block>
        </view>
      </view>
      <!-- 底部空白占位符 -->
      <view class="h-4"></view>
    </view>
  </view>
</view>
<!-- 底部导航栏组件 -->
<bottom-nav unread-count="{{unreadCount}}" />
<!-- 成功提示 -->
<view class="success-toast {{showToast ? 'show' : ''}}">
  <text class="iconfont icon-check-circle mr-2"></text>
  {{toastMessage}}
</view>