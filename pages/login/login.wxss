/* pages/login/login.wxss */

/* 页面容器 */
.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  padding: 32rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  position: relative;
}

/* 自定义模态框样式 */
.modal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 80%;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 8rpx;
}

.modal-close:hover {
  color: #666;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  overflow: hidden;
}

.modal-scroll {
  height: 100%;
  max-height: 70vh;
}

.modal-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666;
  white-space: pre-wrap;
}

.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: center;
}

.modal-button {
  background-color: #6B46C1;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
  line-height: 1.2;
  min-height: auto;
}

.modal-button::after {
  border: none;
}

.modal-button:hover {
  background-color: #553C9A;
}

/* 登录容器 */
.login-container {
  width: 100%;
  max-width: 640rpx;
  margin: auto;
  overflow: hidden;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  background-color: white;
}

/* 头部渐变背景 */
.header-bg {
  background: #8b5cf6;
  padding: 50rpx 40rpx;
  color: white;
  position: relative;
  overflow: hidden;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0) 60%);
  opacity: 0.6;
}

/* 内容区域 */
.content-area {
  flex: 1;
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
}

/* 登录按钮 */
.action-button {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  border: none;
  border-radius: 24rpx;
  padding: 12rpx 30rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
  transition: all 0.3s ease;
  width: 100%;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-button:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 30rpx rgba(16, 185, 129, 0.4);
}

.action-button[disabled] {
  opacity: 0.7;
  transform: none;
  box-shadow: none;
}

/* 按钮图标 */
.btn-icon {
  margin-right: 24rpx;
  font-size: 40rpx;
}

/* 文本样式 */
.text-center {
  text-align: center;
}

.block {
  display: block;
}

.text-2xl {
  font-size: 48rpx;
  font-weight: bold;
}

.text-sm {
  font-size: 24rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.opacity-90 {
  opacity: 0.9;
}

.space-y-3 {
  margin-bottom: 24rpx;
}

.mb-6 {
  margin-bottom: 48rpx;
}

.text-xs {
  font-size: 20rpx;
}

.text-gray-500 {
  color: #6b7280;
}

.text-purple-600 {
  color: #8b5cf6;
}

.text-purple-700 {
  color: #7c3aed;
}

/* Flex 布局 */
.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.mr-2 {
  margin-right: 16rpx;
}

/* 隐私政策区域样式 */
.privacy-policy {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
}

.privacy-policy checkbox {
  width: 32rpx;
  height: 32rpx;
  background-color: #f3f4f6;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-policy view,
.privacy-policy text {
  display: flex;
  align-items: center;
}

.privacy-policy .text-purple-600 {
  color: #8b5cf6;
}

.privacy-policy .text-purple-700 {
  color: #7c3aed;
}

/* 复选框样式 */
checkbox {
  width: 32rpx;
  height: 32rpx;
  background-color: #f3f4f6;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

checkbox[checked] {
  background-color: #8b5cf6;
  border-color: #8b5cf6;
}

checkbox .wx-checkbox-input {
  border-radius: 8rpx;
  border-color: #d1d5db;
}

checkbox[checked] .wx-checkbox-input {
  background-color: #8b5cf6;
  border-color: #8b5cf6;
  color: white;
}

/* 底部导航栏样式 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 1rpx solid #e5e7eb;
  z-index: 40;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9ca3af;
  font-size: 20rpx;
  transition: all 0.3s ease;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  position: relative;
}

.nav-item:active {
  color: #8b5cf6;
  background-color: #f3f4f6;
}

.nav-item text:first-child {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.nav-item text:last-child {
  font-weight: 500;
}

/* 导航栏未读消息红点样式 */
.nav-badge {
  position: absolute;
  top: 4rpx;
  right: 16rpx;
  background: #ef4444;
  color: white;
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 16rpx;
  min-width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  z-index: 10;
}