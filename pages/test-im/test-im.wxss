.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.status-section {
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.status-content {
  font-size: 24rpx;
  color: #666;
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.4;
}

.button-section {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.button-section button {
  margin: 0;
}

.log-section {
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
}

.log-container {
  height: 400rpx;
  border: 1rpx solid #eee;
  padding: 10rpx;
  border-radius: 5rpx;
}

.log-item {
  font-size: 22rpx;
  color: #666;
  display: block;
  margin-bottom: 5rpx;
  font-family: monospace;
  line-height: 1.3;
}