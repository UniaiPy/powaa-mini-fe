<view class="container">
  <view class="header">
    <text class="title">IM初始化测试</text>
  </view>

  <view class="status-section">
    <text class="section-title">IM状态</text>
    <text class="status-content">{{imStatus ? JSON.stringify(imStatus, null, 2) : '未检查'}}</text>
  </view>

  <view class="button-section">
    <button bindtap="checkIMStatus" type="primary">检查IM状态</button>
    <button bindtap="initIM" type="default">手动初始化IM</button>
    <button bindtap="testLogin" type="default">测试登录状态</button>
    <button bindtap="clearLogs" type="warn">清空日志</button>
  </view>

  <view class="log-section">
    <text class="section-title">操作日志</text>
    <scroll-view class="log-container" scroll-y="true">
      <text wx:for="{{logs}}" wx:key="index" class="log-item">{{item}}</text>
    </scroll-view>
  </view>
</view>