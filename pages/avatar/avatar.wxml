<!-- pages/avatar/avatar.wxml -->
<view class="container">
  <!-- 顶部导航 -->
  <custom-navigation-bar id="customNavigationBar" bar-style="1" background='#fff' color='#000'>
    <view class="flex items-center justify-between text-black relative" style="width: 100%;height: 100%;">
      <!-- <view class="title text-base font-bold">我的AI分身</view> -->
      <view class="">
        <view class="w-16 h-16" bindtap="navigateToAbout">
          <image src="/images/ai.png" class="w-full h-full rounded-lg" mode="aspectFill"></image>
        </view>
      </view>
      <view class="flex items-center justify-center">
        <view class="atom-btn flex items-center justify-center" bindtap="toggleModelMenu">
          <image src="/assets/icons/icon-atom.png"></image>
        </view>
        <view class="chart-btn ml-7" bindtap="openAIReport">
          <!-- <image src="/assets/icons/icon-chart.png"></image> -->
          <view class="text-sm px-4 text-center flex items-center justify-center bg-gray-300 rounded-full py-1">
            <image src="/assets/icons/icon-chart.png" class="mr-2"></image>
            AI报告
          </view>
        </view>
      </view>
    </view>
  </custom-navigation-bar>
  <!-- 聊天容器 -->
  <scroll-view class="chat-container" scroll-with-animation="{{scrollWithAnimation}}" scroll-y="true" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="false" bindtap="hideAllMenus" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh" bindrefresherrestore="onPullDownRefreshComplete" show-scrollbar="{{showScrollbar}}" enhanced="true">
    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
    <!-- 错误状态 -->
    <view class="error-container" wx:if="{{error}}">
      <text class="error-text">{{error}}</text>
      <button class="retry-btn" bindtap="loadHistoryMessages">重试</button>
    </view>
    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="id">
      <!-- 时间分隔符 -->
      <view class="time-separator" wx:if="{{item.showTimeSeparator}}">
        <text class="time-text">{{item.time}}</text>
      </view>
      <view class="message-wrapper {{item.type === 'user' ? 'justify-end' : ''}}" id="message-{{item.id}}">
        <!-- AI消息 -->
        <block wx:if="{{item.type === 'ai'}}">
          <view class="avatar-circle other-avatar">
            <image src="/images/robot-avatar.png" mode="aspectFill"></image>
          </view>
          <view class="message other-message {{item.messageType === 'image' ? 'message-image-container' : ''}} {{item.messageType === 'location' ? 'message-location-container' : ''}} {{item.messageType === 'file' ? 'message-file-container' : ''}}" data-message="{{item}}">
            <!-- 文本消息 -->
            <block wx:if="{{item.messageType === 'text' || !item.messageType}}">
              <text>{{item.content}}</text>
              <!-- 流式消息指示器 -->
              <text class="streaming-indicator" wx:if="{{item.isStreaming}}">...</text>
            </block>
            <!-- 图片消息 -->
            <block wx:elif="{{item.messageType === 'image'}}">
              <image src="{{item.imageUrl}}" mode="aspectFill" class="message-image message-type-image" bindtap="previewImage" data-src="{{item.imageUrl}}"></image>
            </block>
            <!-- 文件消息 -->
            <block wx:elif="{{item.messageType === 'file'}}">
              <view class="message-file message-type-file" bindtap="previewFile" data-message="{{item}}">
                <view class="file-icon" style="color: {{item.fileTypeInfo.color}}; background: {{item.fileTypeInfo.bgColor}};">
                  <text class="fa {{item.fileTypeInfo.icon}}"></text>
                </view>
                <view class="file-info">
                  <text class="file-name">{{item.fileName}}</text>
                  <text class="file-size">{{item.fileSize}}</text>
                </view>
              </view>
            </block>
            <!-- 位置消息 -->
            <block wx:elif="{{item.messageType === 'location'}}">
              <view class="message-location" bindtap="openLocationMap" data-location="{{item.location}}">
                <view class="location-name" wx:if="{{item.location.name}}">
                  {{item.location.name}}
                </view>
                <view class="location-address">{{item.location.address}}</view>
                <map enable-scroll="{{mapScroll}}" enable-zoom="{{mapZoom}}" longitude="{{item.location.longitude}}" latitude="{{item.location.latitude}}" scale="16" markers="{{[{id: 1, latitude: item.location.latitude, longitude: item.location.longitude, width: 24, height: 24, iconPath: '/assets/icons/location.png'}]}}" class="location-map">
                  <view bindtap="openLocationMap" data-location="{{item.location}}" class="location-map-cover"></view>
                </map>
              </view>
            </block>
            <!-- 表情消息 -->
            <block wx:elif="{{item.messageType === 'face'}}">
              <view class="message-face">
                <text>{{item.faceData}}</text>
              </view>
            </block>
            <!-- 语音消息 -->
            <block wx:elif="{{item.messageType === 'audio'}}">
              <view class="message-audio" bindtap="playAudio" data-message="{{item}}">
                <text class="fa fa-play-circle audio-icon"></text>
                <text class="audio-duration">{{item.duration}}s</text>
              </view>
            </block>
            <!-- 视频消息 -->
            <block wx:elif="{{item.messageType === 'video'}}">
              <view class="message-video">
                <video src="{{item.videoUrl}}" controls="true" class="video-player"></video>
              </view>
            </block>
            <!-- 系统消息 -->
            <block wx:elif="{{item.messageType === 'system'}}">
              <view class="message-system">
                <text>{{item.content}}</text>
              </view>
            </block>
            <!-- 撤回消息 -->
            <block wx:elif="{{item.isRevoked}}">
              <view class="message-revoked">
                <text>{{item.content}}</text>
              </view>
            </block>
          </view>
        </block>
        <!-- 用户消息 -->
        <block wx:else>
          <view class="message user-message {{item.messageType === 'image' ? 'message-image-container' : ''}} {{item.messageType === 'location' ? 'message-location-container' : ''}} {{item.messageType === 'file' ? 'message-file-container' : ''}}" data-message="{{item}}">
            <!-- 文本消息 -->
            <block wx:if="{{item.messageType === 'text' || !item.messageType}}">
              <text>{{item.content}}</text>
            </block>
            <!-- 图片消息 -->
            <block wx:elif="{{item.messageType === 'image'}}">
              <image src="{{item.imageUrl}}" mode="aspectFill" class="message-image message-type-image" bindtap="previewImage" data-src="{{item.imageUrl}}"></image>
            </block>
            <!-- 文件消息 -->
            <block wx:elif="{{item.messageType === 'file'}}">
              <view class="message-file message-type-file" bindtap="previewFile" data-message="{{item}}">
                <view class="file-icon" style="color: {{item.fileTypeInfo.color}}; background: {{item.fileTypeInfo.bgColor}};">
                  <text class="fa {{item.fileTypeInfo.icon}}"></text>
                </view>
                <view class="file-info">
                  <text class="file-name">{{item.fileName}}</text>
                  <text class="file-size">{{item.fileSize}}</text>
                </view>
              </view>
            </block>
            <!-- 位置消息 -->
            <block wx:elif="{{item.messageType === 'location'}}">
              <view class="message-location" bindtap="openLocationMap" data-location="{{item.location}}">
                <!-- <text class="location-name">{{item.location.name || '位置'}}</text> -->
                <view class="location-name" wx:if="{{item.location.name}}">
                  {{item.location.name}}
                </view>
                <view class="location-address">{{item.location.address}}</view>
                <map enable-scroll="{{mapScroll}}" enable-zoom="{{mapZoom}}" longitude="{{item.location.longitude}}" latitude="{{item.location.latitude}}" scale="16" markers="{{[{id: 1, latitude: item.location.latitude, longitude: item.location.longitude, width: 24, height: 24, iconPath: '/assets/icons/location.png'}]}}" class="location-map">
                  <view bindtap="openLocationMap" data-location="{{item.location}}" class="location-map-cover"></view>
                </map>
              </view>
            </block>
            <!-- 表情消息 -->
            <block wx:elif="{{item.messageType === 'face'}}">
              <view class="message-face">
                <text>{{item.faceData}}</text>
              </view>
            </block>
            <!-- 语音消息 -->
            <block wx:elif="{{item.messageType === 'audio'}}">
              <view class="message-audio" bindtap="playAudio" data-message="{{item}}">
                <text class="fa fa-play-circle audio-icon"></text>
                <text class="audio-duration">{{item.duration}}s</text>
              </view>
            </block>
            <!-- 视频消息 -->
            <block wx:elif="{{item.messageType === 'video'}}">
              <view class="message-video">
                <video src="{{item.videoUrl}}" controls="true" class="video-player"></video>
              </view>
            </block>
            <!-- 撤回消息 -->
            <block wx:elif="{{item.isRevoked}}">
              <view class="message-revoked">
                <text>{{item.content}}</text>
              </view>
            </block>
            <!-- 发送失败标识 -->
            <view wx:if="{{item.sendFailed}}" class="send-failed-indicator">
              <text class="fa fa-exclamation-circle"></text>
            </view>
          </view>
          <view class="avatar-circle user-avatar cursor-pointer" bindtap="goToProfile">
            <image src="{{item.avatar}}" mode="aspectFill"></image>
          </view>
        </block>
      </view>
    </block>
    <!-- 底部占位 -->
    <!-- <view class="bottom-space"></view> -->
  </scroll-view>
  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-container">
      <view class="plus-btn" bindtap="showPlusMenu">
        <text class="fa fa-plus"></text>
      </view>
      <textarea cursor-spacing="25" class="input-field" model:value="{{inputValue}}" placeholder="输入消息..." bindconfirm="sendMessage" auto-height="true" style="min-height: 40px;" show-confirm-bar="false" />
      <!-- <view class="hold-to-talk-btn" wx:if="{{isVoiceMode}}" bindtouchstart="startRecording" bindtouchend="stopRecording">
        <text class="fa fa-microphone"></text>
        <text>按住说话</text>
      </view> -->
      <view class="send-btn {{sendBtnDisabled ? 'disabled' : ''}}" bindtap="sendMessage" disabled="{{sendBtnDisabled}}">
        <text class="fa fa-paper-plane"></text>
      </view>
    </view>
    <view class="text-xs text-tertiary flex items-center justify-center py-2">
      <text class="fa fa-info-circle mr-2"></text>
      <text>内容由 AI 生成，仅供参考</text>
    </view>
    <!-- 功能菜单 -->
    <view class="function-menu {{showFunctionMenu ? 'show' : ''}}">
      <view class="function-grid">
        <view class="function-item" bindtap="onFunctionItemClick" data-type="image">
          <view class="function-icon image">
            <text class="fa fa-image"></text>
          </view>
          <view class="function-label">图片</view>
        </view>
        <view class="function-item" bindtap="onFunctionItemClick" data-type="file">
          <view class="function-icon file">
            <text class="fa fa-file"></text>
          </view>
          <view class="function-label">文件</view>
        </view>
        <view class="function-item" bindtap="onFunctionItemClick" data-type="location">
          <view class="function-icon location">
            <text class="fa fa-map-marker"></text>
          </view>
          <view class="function-label">位置</view>
        </view>
        <view class="function-item" bindtap="onFunctionItemClick" data-type="emoji">
          <view class="function-icon emoji">
            <text class="fa fa-smile-o"></text>
          </view>
          <view class="function-label">表情</view>
        </view>
      </view>
    </view>
  </view>
  <!-- AI分身悬浮按钮 -->
  <view class="ai-avatar-button {{aiOnline ? '' : 'offline'}}" bindtap="toggleAIMenu">
    <view class="ai-avatar-ripple"></view>
    <view class="ai-avatar-icon">
      <image src="/assets/icons/robot.png"></image>
    </view>
  </view>
  <!-- AI分身开关菜单 -->
  <view class="ai-menu {{showAIMenu ? 'show' : ''}}" data-menu="ai-menu" catchtap="preventDefault">
    <view class="ai-toggle-container">
      <view class="ai-label">{{aiOnline ? 'AI分身已上线' : 'AI分身已下线'}}</view>
      <view class="ai-toggle-switch">
        <switch class="ai-toggle-input" checked="{{aiOnline}}" bindchange="toggleAiOnline" />
        <!-- <view class="ai-toggle-slider"></view> -->
      </view>
    </view>
  </view>
  <!-- AI模型选择菜单 -->
  <view class="model-menu {{showModelMenu ? 'show' : ''}}" data-menu="model-menu">
    <view class="model-header">
      <view class="model-title">选择AI模型</view>
    </view>
    <view wx:for="{{modelList}}" wx:key="item" class="model-item {{selectedModel === item ? 'active' : ''}}" bindtap="selectModel" data-model="{{item}}">
      <view class="model-info">
        <view class="model-name">{{item}}</view>
      </view>
      <view class="model-status"></view>
    </view>
  </view>
  <!-- 表情选择器 -->
  <view class="emoji-picker {{showEmojiPicker ? 'show' : ''}}" wx:if="{{showEmojiPicker}}" catchtap="preventDefault">
    <view class="emoji-picker-header">
      <text class="emoji-picker-title">选择表情</text>
      <view class="emoji-picker-close" bindtap="hideEmojiPicker">
        <text class="fa fa-times"></text>
      </view>
    </view>
    <view class="emoji-grid">
      <view class="emoji-item" wx:for="{{emojiList}}" wx:key="index" bindtap="onEmojiSelect" data-emoji="{{item}}" data-index="{{index}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>
</view>