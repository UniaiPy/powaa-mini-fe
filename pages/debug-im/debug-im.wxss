.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.reload-btn {
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
}

.error-section {
  background-color: #ffebee;
  border: 1px solid #f44336;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.error-title {
  font-weight: bold;
  color: #d32f2f;
  display: block;
  margin-bottom: 10rpx;
}

.error-content {
  color: #d32f2f;
  font-size: 28rpx;
}

.status-section, .applications-section {
  background-color: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.status-item, .app-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.status-item:last-child, .app-info:last-child {
  border-bottom: none;
}

.status-label, .app-label {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

.status-value, .app-value {
  font-size: 28rpx;
  color: #333;
  flex: 2;
  text-align: right;
  word-break: break-all;
}

.no-applications {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.application-item {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}