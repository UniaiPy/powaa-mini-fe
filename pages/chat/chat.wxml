<!-- pages/chat/chat.wxml -->
<view class="page-container" bindtap="closeSlideview">
  <!-- 顶部导航 -->
  <custom-navigation-bar id="customNavigationBar" bar-style="1" background='#fff' color='#000'>
    <view class="fixed-nav py-3 px-6" style="height: 100%;">
      <view class="flex-container">
        <view class="">
          <view class="w-16 h-16" bindtap="navigateToAbout">
            <image src="/images/ai.png" class="w-full h-full rounded-lg" mode="aspectFill"></image>
          </view>
        </view>
        <view class="flex-1 text-c">
          <!-- <text class="text-base font-bold text-gray-900">聊天</text> -->
        </view>
        <view class="text-r">
          <view bindtap="openSearch">
            <text class="fa fa-search text-black text-lg"></text>
          </view>
        </view>
      </view>
    </view>
  </custom-navigation-bar>
  <!-- 主内容区域 -->
  <view class="content-container">
    <scroll-view class="content-with-fixed-nav" scroll-y="true">
      <view>
        <!-- 分组标题行 -->
        <view class="flex bg-gray-50 rounded-lg shadow-sm mb-3">
          <view class="flex-1 chat-section-title {{activeSection === 'contacts' ? 'active' : ''}}" bindtap="toggleSection" data-section="contacts">
            <text>联系人</text>
          </view>
          <view class="flex-1 chat-section-title border-l border-gray-200 {{activeSection === 'pending' ? 'active' : ''}}" bindtap="toggleSection" data-section="pending">
            <text>待联系</text>
            <view wx:if="{{applyCount > 0}}" class="pending-badge">{{applyCount}}</view>
          </view>
        </view>
        <!-- 联系人内容 -->
        <view class="bg-white rounded-lg shadow-sm" wx:if="{{activeSection === 'contacts'}}">
          <!-- 联系人列表 -->
          <block wx:if="{{contactsList.length > 0}}">
            <block wx:for="{{contactsList}}" wx:for-index="index" wx:key="id">
              <mp-slideview buttons="{{item.isPinned ? [{text: '取消置顶', type: 'default'}] : [{text: '置顶', type: 'warn'}]}}" bindbuttontap="slideButtonTap" show="{{index == currentItemIndex}}" bindshow="handleShow" data-index="{{index}}" data-user="{{item}}">
                <view class="chat-card {{item.isPinned ? 'pinned-conversation' : ''}}" bindtap="navigateContactToConversation" data-user="{{item}}">
                  <view class="flex items-center">
                    <view class="w-24 h-24 rounded-full overflow-hidden mr-6">
                      <image src="{{item.avatar}}" class="w-full h-full object-cover rounded-full"></image>
                    </view>
                    <view class="flex-1">
                      <view class="flex items-center justify-between mb-2">
                        <view class="flex items-center">
                          <view class="text-base font-semibold text-gray-900 whitespace-nowrap overflow-hidden text-ellipsis max-w-160">
                            {{item.name}}
                          </view>
                          <view class="text-xs text-gray-400 ml-6 flex items-center" wx:if="{{item.matchPercent > 0}}">
                            <view class="bg-gray-200 py-2 rounded-full">
                              {{item.matchPercent}}%
                            </view>
                            <text class="fa fa-star text-red-500 ml-2" wx:if="{{item.matchPercent >= 85}}"></text>
                            <text class="fa fa-arrow-up text-green-600 ml-2" wx:if="{{item.matchPercent >= 75 && item.matchPercent < 85}}"></text>
                          </view>
                        </view>
                        <view class="text-xs text-gray-400 whitespace-nowrap ml-3">
                          {{item.time}}
                        </view>
                      </view>
                      <view class="flex items-center justify-between">
                        <text class="last-message multi-line">{{item.lastMessage}}</text>
                        <view class="ml-4" wx:if="{{item.unread > 0}}">
                          <view class="unread-badge">
                            {{item.unread > 99 ? '99+' : item.unread}}
                          </view>
                        </view>
                      </view>
                    </view>
                  </view>
                </view>
              </mp-slideview>
            </block>
          </block>
          <!-- 空状态 -->
          <view class="empty-state" wx:else>
            <view class="empty-content">
              <image src="/images/empty_chat.png" class="empty-icon w-24 h-24" mode="widthFix"></image>
              <text class="empty-text">暂无会话记录</text>
            </view>
          </view>
        </view>
        <!-- 待联系内容 -->
        <view class="bg-white rounded-lg shadow-sm" wx:if="{{activeSection === 'pending'}}">
          <!-- 待联系列表 -->
          <block wx:if="{{pendingContactList.length > 0}}">
            <block wx:for="{{pendingContactList}}" wx:key="id">
              <view class="chat-card" bindtap="{{item.status === 'friend' ? 'navigatePendingToConversation' : ''}}" data-user="{{item}}">
                <view class="flex items-center">
                  <view class="w-24 h-24 rounded-full overflow-hidden mr-6" bindtap="navigateToPreview" data-user="{{item}}">
                    <image src="{{item.avatar}}" class="w-full h-full object-cover"></image>
                  </view>
                  <view class="flex-1">
                    <view class="flex items-center justify-between mb-2">
                      <text class="text-base font-semibold text-gray-900">{{item.name}}</text>
                    </view>
                    <text class="last-message multi-line">{{item.message}}</text>
                  </view>
                  <view class="ml-4">
                    <view class="action-buttons">
                      <text class="text-xs text-gray-400 whitespace-nowrap">{{item.time}}</text>
                      <button wx:if="{{item.status === 'applying'}}" class="accept-btn" bindtap="acceptMatch" data-id="{{item.userId}}" data-name="{{item.name}}" size="mini">
                        同意
                      </button>
                      <button wx:if="{{item.status === 'applying'}}" class="reject-btn" bindtap="rejectMatch" data-id="{{item.userId}}" data-name="{{item.name}}" size="mini">
                        拒绝
                      </button>
                      <button wx:if="{{item.status !== 'applying'}}" class="{{item.status === 'pending' ? 'pending-btn' : 'agree-btn'}}" size="mini">
                        {{item.status === 'pending' ? '待验证' : '已同意'}}
                      </button>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </block>
          <!-- 空状态 -->
          <view class="empty-state" wx:else>
            <view class="empty-content">
              <image src="/images/empty_chat.png" class="empty-icon w-24 h-24" mode="widthFix"></image>
              <text class="empty-text">暂无新的好友请求</text>
            </view>
          </view>
        </view>
        <!-- 底部空白占位符 -->
        <view class="h-40"></view>
      </view>
    </scroll-view>
    <!-- 搜索框覆盖层 -->
    <view class="search-overlay" wx:if="{{showSearch}}">
      <!-- <view class="search-overlay" bindtap="closeSearch"></view> -->
      <view class="search-container">
        <view class="search-input-container">
          <input type="text" cursor-spacing="10" class="search-input" placeholder="搜索联系人、聊天记录" value="{{searchText}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="performSearch" focus="true" />
          <view class="search-actions">
            <button class="search-btn" bindtap="performSearch" size="mini" plain="false">
              <text class="fa fa-search"></text>
            </button>
            <button class="cancel-btn" bindtap="closeSearch" size="mini" plain="true">
              <text class="fa fa-times"></text>
            </button>
          </view>
        </view>
        <view class="search-results" wx:if="{{showSearchResults}}">
          <!-- 搜索结果为空时的提示 -->
          <view class="no-results" wx:if="{{searchResults.length === 0}}">
            <text class="no-results-text">未找到相关聊天记录</text>
          </view>
          <!-- 搜索结果列表 -->
          <block wx:elif="{{searchResults.length > 0}}">
            <block wx:for="{{searchResults}}" wx:key="id">
              <view class="search-result-item" bindtap="navigateContactToConversation" data-user="{{item}}">
                <view class="flex items-start">
                  <view class="w-20 h-20 rounded-full overflow-hidden mr-4">
                    <image src="{{item.avatar}}" class="w-full h-full object-cover"></image>
                  </view>
                  <view class="flex-1">
                    <view class="flex items-center justify-between mb-2">
                      <view class="search-result-name">{{item.name}}</view>
                      <view class="search-result-count" wx:if="{{item.matchedMessages && item.matchedMessages.length > 1}}">
                        {{item.matchedMessages.length}}条匹配
                      </view>
                    </view>
                    <!-- 显示匹配的消息 -->
                    <block wx:if="{{item.matchedMessages && item.matchedMessages.length > 0}}">
                      <block wx:for="{{item.matchedMessages}}" wx:key="messageID" wx:for-item="msg">
                        <view class="matched-message">
                          <text class="message-text">{{msg.payload.text}}</text>
                          <text class="message-time">{{msg._createTime}}</text>
                        </view>
                      </block>
                    </block>
                    <block wx:else>
                      <view class="search-result-message">{{item.lastMessage}}</view>
                    </block>
                  </view>
                </view>
              </view>
            </block>
          </block>
        </view>
      </view>
    </view>
  </view>
</view>