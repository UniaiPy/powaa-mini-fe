<!-- pages/chat/chat.wxml -->
<view class="page-container">
  <!-- 顶部导航 -->
  <custom-navigation-bar id="customNavigationBar" bar-style="1" background='#fff' color='#000'>
    <view class="fixed-nav py-3 px-6" style="height: 100%;">
      <view class="flex-container">
        <view class="">
          <view class="w-16 h-16" bindtap="navigateToAbout">
            <image src="/images/ai.png" class="w-full h-full rounded-lg" mode="aspectFill"></image>
          </view>
        </view>
        <view class="flex-1 text-c">
          <text class="text-base font-bold text-gray-900">聊天</text>
        </view>
        <view class="text-r">
          <view bindtap="openSearch">
            <text class="fa fa-search text-black text-lg"></text>
          </view>
        </view>
      </view>
    </view>
  </custom-navigation-bar>
  <!-- 主内容区域 -->
  <view class="content-container">
    <scroll-view class="content-with-fixed-nav" scroll-y="true">
      <view class="py-2">
        <!-- 分组标题行 -->
        <view class="flex bg-gray-50 rounded-lg shadow-sm mb-3">
          <view class="flex-1 chat-section-title {{activeSection === 'contacts' ? 'active' : ''}}" bindtap="toggleSection" data-section="contacts">
            <text>联系人</text>
          </view>
          <view class="flex-1 chat-section-title border-l border-gray-200 {{activeSection === 'pending' ? 'active' : ''}}" bindtap="toggleSection" data-section="pending">
            <text>待联系</text>
            <view wx:if="{{pendingList.length > 0}}" class="pending-badge">
              {{pendingList.length}}
            </view>
          </view>
          <!-- 调试按钮 - 仅在开发环境显示 -->
          <view class="px-2" wx:if="{{!isImInitialized}}" bindtap="checkTUIKitStatus">
            <text class="text-xs text-blue-500">刷新</text>
          </view>
        </view>
        <!-- 联系人内容 -->
        <view class="bg-white rounded-lg shadow-sm" wx:if="{{activeSection === 'contacts'}}">
          <!-- 联系人列表 -->
          <block wx:if="{{contactsList.length > 0}}">
            <block wx:for="{{contactsList}}" wx:key="id">
              <view class="chat-card" bindtap="navigateToConversation" data-user="{{item}}">
                <view class="flex items-center">
                  <view class="w-24 h-24 rounded-full overflow-hidden mr-6">
                    <image src="{{item.avatar}}" class="w-full h-full object-cover"></image>
                  </view>
                  <view class="flex-1">
                    <view class="flex items-center justify-between mb-2">
                      <text class="text-base font-semibold text-gray-900">{{item.name}}</text>
                      <text class="text-xs text-gray-400 whitespace-nowrap">{{item.time}}</text>
                    </view>
                    <view class="flex items-center justify-between">
                      <text class="last-message multi-line">{{item.lastMessage}}</text>
                      <view class="ml-4" wx:if="{{item.unread > 0}}">
                        <view class="unread-badge">{{item.unread > 99 ? '99+' : item.unread}}</view>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </block>
          <!-- 空状态 -->
          <view class="empty-state" wx:else>
            <view class="empty-content">
              <image src="/images/empty_chat.png" class="empty-icon w-24 h-24" mode="widthFix"></image>
              <text class="empty-text">暂无会话记录</text>
            </view>
          </view>
        </view>
        <!-- 待联系内容 -->
        <view class="bg-white rounded-lg shadow-sm" wx:if="{{activeSection === 'pending'}}">
          <!-- 待联系列表 -->
          <block wx:if="{{pendingList.length > 0}}">
            <block wx:for="{{pendingList}}" wx:key="id">
              <view class="chat-card">
                <view class="flex items-center">
                  <view class="w-24 h-24 rounded-full overflow-hidden mr-6">
                    <image src="{{item.avatar}}" class="w-full h-full object-cover"></image>
                  </view>
                  <view class="flex-1">
                    <view class="flex items-center justify-between mb-2">
                      <text class="text-base font-semibold text-gray-900">{{item.name}}</text>
                      <text class="text-xs text-gray-400 whitespace-nowrap">{{item.time}}</text>
                    </view>
                    <text class="last-message multi-line">{{item.message}}</text>
                  </view>
                  <view class="ml-4">
                    <view class="action-buttons">
                      <button class="accept-btn" bindtap="acceptMatch" data-id="{{item.id}}" data-name="{{item.name}}" size="mini">
                        同意
                      </button>
                      <button class="reject-btn" bindtap="rejectMatch" data-id="{{item.id}}" data-name="{{item.name}}" size="mini">
                        拒绝
                      </button>
                    </view>
                  </view>
                </view>
              </view>
            </block>
          </block>
          <!-- 空状态 -->
          <view class="empty-state" wx:else>
            <view class="empty-content">
              <image src="/images/empty_chat.png" class="empty-icon w-24 h-24" mode="widthFix"></image>
              <text class="empty-text">暂无新的好友请求</text>
            </view>
          </view>
        </view>
        <!-- 底部空白占位符 -->
        <view class="h-40"></view>
      </view>
    </scroll-view>
    <!-- 搜索框覆盖层 -->
    <view class="search-overlay" wx:if="{{showSearch}}">
      <!-- <view class="search-overlay" bindtap="closeSearch"></view> -->
      <view class="search-container">
        <view class="search-input-container">
          <input type="text" class="search-input" placeholder="搜索联系人、聊天记录" value="{{searchText}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="performSearch" focus="true" />
          <view class="search-actions">
            <button class="search-btn" bindtap="performSearch" size="mini" plain="false">
              <text class="fa fa-search"></text>
            </button>
            <button class="cancel-btn" bindtap="closeSearch" size="mini" plain="true">
              <text class="fa fa-times"></text>
            </button>
          </view>
        </view>
        <view class="search-results" wx:if="{{showSearchResults}}">
          <!-- 搜索结果为空时的提示 -->
          <view class="no-results" wx:if="{{searchResults.length === 0}}">
            <text class="no-results-text">未找到相关聊天记录</text>
          </view>
          <!-- 搜索结果列表 -->
          <block wx:elif="{{searchResults.length > 0}}">
            <block wx:for="{{searchResults}}" wx:key="id">
              <view class="search-result-item" bindtap="navigateToConversation" data-user="{{item}}">
                <view class="flex items-center">
                  <view class="w-20 h-20 rounded-full overflow-hidden mr-4">
                    <image src="{{item.avatar}}" class="w-full h-full object-cover"></image>
                  </view>
                  <view class="flex-1">
                    <view class="search-result-name">{{item.name}}</view>
                    <view class="search-result-message">{{item.lastMessage}}</view>
                  </view>
                </view>
              </view>
            </block>
          </block>
        </view>
      </view>
    </view>
  </view>
</view>