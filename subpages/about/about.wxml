<!-- subpages/about/about.wxml -->
<view class="container">
  <!-- 顶部导航 -->
  <!-- <view class="fixed-nav">
    <view class="left-placeholder"></view>
    <text class="nav-title">小瓦AI分身</text>
    <view class="right-placeholder"></view>
  </view> -->
  <!-- 主要内容区域 -->
  <view class="content-with-fixed-nav">
    <view class="bg-white">
      <!-- 关于我们 -->
      <view class="section-card">
        <view class="section-header" bindtap="toggleSection" data-section="about">
          <view class="section-title">关于我们</view>
          <text class="fa fa-chevron-down toggle-icon {{isOpen.about ? 'rotated' : ''}}"></text>
        </view>
        <view class="section-content" wx:if="{{isOpen.about}}">
          <rich-text nodes="{{aboutContent}}"></rich-text>
        </view>
      </view>
      <!-- 使用帮助 -->
      <view class="section-card">
        <view class="section-header" bindtap="toggleSection" data-section="help">
          <view class="section-title">使用帮助</view>
          <text class="fa fa-chevron-down toggle-icon {{isOpen.help ? 'rotated' : ''}}"></text>
        </view>
        <view class="space-y-4" wx:if="{{isOpen.help}}">
          <rich-text nodes="{{helpContent}}"></rich-text>
        </view>
      </view>
      <!-- 用户协议 -->
      <view class="section-card">
        <view class="section-header" bindtap="toggleSection" data-section="terms">
          <view class="section-title">用户协议</view>
          <text class="fa fa-chevron-down toggle-icon {{isOpen.terms ? 'rotated' : ''}}"></text>
        </view>
        <view class="space-y-4" wx:if="{{isOpen.terms}}">
          <rich-text nodes="{{termsContent}}"></rich-text>
        </view>
      </view>
      <!-- 隐私政策 -->
      <view class="section-card">
        <view class="section-header" bindtap="toggleSection" data-section="privacy">
          <view class="section-title">隐私政策</view>
          <text class="fa fa-chevron-down toggle-icon {{isOpen.privacy ? 'rotated' : ''}}"></text>
        </view>
        <view class="space-y-4" wx:if="{{isOpen.privacy}}">
          <rich-text nodes="{{privacyContent}}"></rich-text>
        </view>
      </view>
      <!-- 联系我们 -->
      <view class="section-card">
        <view class="section-header" bindtap="toggleSection" data-section="contact">
          <view class="section-title">联系我们</view>
          <text class="fa fa-chevron-down toggle-icon {{isOpen.contact ? 'rotated' : ''}}"></text>
        </view>
        <view class="space-y-2" wx:if="{{isOpen.contact}}">
          <view class="contact-item" bindtap="navigateToPreview">
            <view class="contact-icon service-icon">
              <text class="fa fa-user"></text>
            </view>
            <view class="contact-info">
              <view class="contact-label">小瓦客服</view>
              <view class="contact-value">7*24h在线</view>
            </view>
          </view>
          <view class="contact-item" bindtap="makePhoneCall">
            <view class="contact-icon phone-icon">
              <text class="fa fa-phone"></text>
            </view>
            <view class="contact-info">
              <view class="contact-label">商务合作</view>
              <view class="contact-value">{{contactInfo.phone}}</view>
            </view>
          </view>
          <view class="contact-item">
            <view class="contact-icon wechat-icon">
              <text class="fa fa-weixin"></text>
            </view>
            <view class="contact-info">
              <view class="contact-label">微信公众号</view>
              <view class="contact-value">{{contactInfo.wechat}}</view>
            </view>
          </view>
        </view>
      </view>
      <!-- 版权信息 -->
      <view class="copyright-text">小瓦AI分身 © 2025</view>
    </view>
  </view>
  <!-- 底部导航栏组件 -->
  <bottom-nav unread-count="{{unreadCount}}" />
</view>