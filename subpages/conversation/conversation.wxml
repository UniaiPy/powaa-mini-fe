<!-- 会话页面 -->
<view class="container">
  <!-- 顶部导航栏 -->
  <custom-navigation-bar id="customNavigationBar" bar-style="2" background='#fff' color='#000'>
    <view class="user-info-bar">
      <view class="user-info flex-1">
        <view class="flex items-center justify-center">
          <view id="userName" class="user-name text-base font-bold text-gray-900">
            {{chatInfo.name || chatInfo.nick || chatInfo.nickname || ''}}
          </view>
          <view class="user-status ml-2 flex items-center"></view>
        </view>
      </view>
      <view id="moreOptionsBtn" class="more-options-btn" bindtap="toggleMoreOptions">
        <text class="fa fa-ellipsis-v"></text>
      </view>
    </view>
  </custom-navigation-bar>
  <!-- <view class="user-info-bar">
    <view class="back-btn" bindtap="navigateToChat">
      <text class="fa fa-chevron-left text-black text-lg"></text>
    </view>
    <view class="user-info flex-1">
      <view class="flex items-center">
        <text id="userName" class="user-name text-xl font-bold text-gray-900">张小明</text>
        <view class="user-status ml-2 flex items-center"></view>
      </view>
    </view>
    <view id="moreOptionsBtn" class="more-options-btn" bindtap="toggleMoreOptions">
      <text class="fa fa-ellipsis-h"></text>
    </view>
  </view> -->
  <!-- 更多选项菜单 -->
  <view id="moreOptionsMenu" class="more-options-menu {{showMoreOptions ? 'show' : ''}}" wx:if="{{showMoreOptions}}">
    <view class="option-item" bindtap="navigateToUserProfile">
      <text class="fa fa-address-card text-gray-500 w-5"></text>
      <text class="ml-2 text-gray-700 text-sm">查看名片</text>
    </view>
    <view class="option-item" bindtap="shareCard">
      <text class="fa fa-share-alt text-gray-500 w-5"></text>
      <text class="ml-2 text-gray-700 text-sm">分享名片</text>
    </view>
    <!-- <view class="option-item" bindtap="reportUser">
      <text class="fa fa-flag text-gray-500 w-5"></text>
      <text class="ml-2 text-gray-700 text-sm">举报用户</text>
    </view> -->
    <view class="option-item" bindtap="{{isUserBlocked ? 'unblockUser' : 'blockUser'}}">
      <text class="fa fa-ban text-gray-500 w-5"></text>
      <text class="ml-2 text-gray-700 text-sm">{{isUserBlocked ? '解除屏蔽' : '屏蔽用户'}}</text>
    </view>
  </view>
  <!-- 聊天容器 -->
  <scroll-view class="chat-container" scroll-y="true" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="false" bindtap="hideAllMenus" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh" bindrefresherrestore="onPullDownRefreshComplete" show-scrollbar="false" enhanced="true">
    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
    <!-- 错误状态 -->
    <view class="error-container" wx:if="{{error}}">
      <text class="error-text">{{error}}</text>
      <button class="retry-btn" bindtap="loadHistoryMessages">重试</button>
    </view>
    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="id">
      <!-- 时间分隔符 -->
      <view class="time-separator" wx:if="{{item.showTimeSeparator}}">
        <text class="time-text">{{item.time}}</text>
      </view>
      <view class="message-wrapper {{item.type === 'user' ? 'justify-end' : ''}}" id="message-{{item.id}}">
        <!-- 对方消息 -->
        <block wx:if="{{item.type === 'other'}}">
          <view class="avatar-circle other-avatar" bindtap="navigateToPreview">
            <image src="{{item.avatar}}" mode="aspectFill"></image>
          </view>
          <view class="message other-message {{item.messageType === 'image' ? 'message-image-container' : ''}} {{item.messageType === 'location' ? 'message-location-container' : ''}} {{item.messageType === 'file' ? 'message-file-container' : ''}}" bindlongpress="onMessageLongPress" data-message="{{item}}">
            <!-- 文本消息 -->
            <block wx:if="{{item.messageType === 'text' || !item.messageType}}">
              <text>{{item.content}}</text>
            </block>
            <!-- 图片消息 -->
            <block wx:elif="{{item.messageType === 'image'}}">
              <image src="{{item.imageUrl}}" mode="aspectFit" class="message-image message-type-image" bindtap="previewImage" data-src="{{item.imageUrl}}"></image>
            </block>
            <!-- 文件消息 -->
            <block wx:elif="{{item.messageType === 'file'}}">
              <view class="message-file message-type-file" bindtap="previewFile" data-message="{{item}}">
                <view class="file-icon" style="color: {{item.fileTypeInfo.color}}; background: {{item.fileTypeInfo.bgColor}};">
                  <text class="fa {{item.fileTypeInfo.icon}}"></text>
                </view>
                <view class="file-info">
                  <text class="file-name">{{item.fileName}}</text>
                  <text class="file-size">{{item.fileSize}}</text>
                </view>
              </view>
            </block>
            <!-- 位置消息 -->
            <block wx:elif="{{item.messageType === 'location'}}">
              <view class="message-location" bindtap="openLocationMap" data-location="{{item.location}}">
                <view class="location-name" wx:if="{{item.location.name}}">
                  {{item.location.name}}
                </view>
                <view class="location-address">{{item.location.address}}</view>
                <map longitude="{{item.location.longitude}}" latitude="{{item.location.latitude}}" scale="16" markers="{{[{id: 1, latitude: item.location.latitude, longitude: item.location.longitude, width: 24, height: 32, iconPath: '/assets/icons/location.png'}]}}" class="location-map"></map>
              </view>
            </block>
            <!-- 表情消息 -->
            <block wx:elif="{{item.messageType === 'face'}}">
              <view class="message-face">
                <text>{{item.faceData}}</text>
              </view>
            </block>
            <!-- 语音消息 -->
            <block wx:elif="{{item.messageType === 'audio'}}">
              <view class="message-audio" bindtap="playAudio" data-message="{{item}}">
                <text class="fa fa-play-circle audio-icon"></text>
                <text class="audio-duration">{{item.duration}}s</text>
              </view>
            </block>
            <!-- 视频消息 -->
            <block wx:elif="{{item.messageType === 'video'}}">
              <view class="message-video">
                <video src="{{item.videoUrl}}" controls="true" class="video-player"></video>
              </view>
            </block>
            <!-- 系统消息 -->
            <block wx:elif="{{item.messageType === 'system'}}">
              <view class="message-system">
                <text>{{item.content}}</text>
              </view>
            </block>
            <!-- 撤回消息 -->
            <block wx:elif="{{item.isRevoked}}">
              <view class="message-revoked">
                <text>{{item.content}}</text>
              </view>
            </block>
          </view>
        </block>
        <!-- 用户消息 -->
        <block wx:else>
          <view class="message user-message {{item.messageType === 'image' ? 'message-image-container' : ''}} {{item.messageType === 'location' ? 'message-location-container' : ''}} {{item.messageType === 'file' ? 'message-file-container' : ''}}" bindlongpress="onMessageLongPress" data-message="{{item}}">
            <!-- 文本消息 -->
            <block wx:if="{{item.messageType === 'text' || !item.messageType}}">
              <text>{{item.content}}</text>
            </block>
            <!-- 图片消息 -->
            <block wx:elif="{{item.messageType === 'image'}}">
              <image src="{{item.imageUrl}}" mode="aspectFit" class="message-image message-type-image" bindtap="previewImage" data-src="{{item.imageUrl}}"></image>
            </block>
            <!-- 文件消息 -->
            <block wx:elif="{{item.messageType === 'file'}}">
              <view class="message-file message-type-file" bindtap="previewFile" data-message="{{item}}">
                <view class="file-icon" style="color: {{item.fileTypeInfo.color}}; background: {{item.fileTypeInfo.bgColor}};">
                  <text class="fa {{item.fileTypeInfo.icon}}"></text>
                </view>
                <view class="file-info">
                  <text class="file-name">{{item.fileName}}</text>
                  <text class="file-size">{{item.fileSize}}</text>
                </view>
              </view>
            </block>
            <!-- 位置消息 -->
            <block wx:elif="{{item.messageType === 'location'}}">
              <view class="message-location" bindtap="openLocationMap" data-location="{{item.location}}">
                <view class="location-name" wx:if="{{item.location.name}}">
                  {{item.location.name}}
                </view>
                <view class="location-address">{{item.location.address}}</view>
                <map enable-scroll="false" longitude="{{item.location.longitude}}" latitude="{{item.location.latitude}}" scale="16" markers="{{[{id: 1, latitude: item.location.latitude, longitude: item.location.longitude, width: 24, height: 24, iconPath: '/assets/icons/location.png'}]}}" class="location-map"></map>
              </view>
            </block>
            <!-- 表情消息 -->
            <block wx:elif="{{item.messageType === 'face'}}">
              <view class="message-face">
                <text>{{item.faceData}}</text>
              </view>
            </block>
            <!-- 语音消息 -->
            <block wx:elif="{{item.messageType === 'audio'}}">
              <view class="message-audio" bindtap="playAudio" data-message="{{item}}">
                <text class="fa fa-play-circle audio-icon"></text>
                <text class="audio-duration">{{item.duration}}s</text>
              </view>
            </block>
            <!-- 视频消息 -->
            <block wx:elif="{{item.messageType === 'video'}}">
              <view class="message-video">
                <video src="{{item.videoUrl}}" controls="true" class="video-player"></video>
              </view>
            </block>
            <!-- 撤回消息 -->
            <block wx:elif="{{item.isRevoked}}">
              <view class="message-revoked">
                <text>{{item.content}}</text>
              </view>
            </block>
          </view>
          <view class="avatar-circle user-avatar">
            <image src="{{item.avatar}}" mode="aspectFill"></image>
          </view>
        </block>
      </view>
    </block>
    <!-- 底部占位 -->
    <!-- <view class="bottom-space"></view> -->
  </scroll-view>
  <!-- 表情选择器 -->
  <view class="emoji-picker {{showEmojiPicker ? 'show' : ''}}" wx:if="{{showEmojiPicker}}" catchtap="preventDefault">
    <view class="emoji-picker-header">
      <text class="emoji-picker-title">选择表情</text>
      <view class="emoji-picker-close" bindtap="hideEmojiPicker">
        <text class="fa fa-times"></text>
      </view>
    </view>
    <view class="emoji-grid">
      <view class="emoji-item" wx:for="{{emojiList}}" wx:key="index" bindtap="onEmojiSelect" data-emoji="{{item}}" data-index="{{index}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>
  <!-- 消息操作菜单 -->
  <view class="message-action-menu {{showMessageMenu ? 'show' : ''}}" wx:if="{{showMessageMenu}}" style="left: {{menuPosition.left}}px; top: {{menuPosition.top}}px;">
    <view class="action-item" bindtap="copyMessage" data-message="{{selectedMessage}}">
      <text class="fa fa-copy"></text>
      <text>复制</text>
    </view>
    <view class="action-item" bindtap="modifyMessage" data-message="{{selectedMessage}}" wx:if="{{selectedMessage.type === 'user' && selectedMessage.messageType === 'text' && !selectedMessage.isRevoked}}">
      <text class="fa fa-edit"></text>
      <text>修改</text>
    </view>
    <view class="action-item" bindtap="revokeMessage" data-message="{{selectedMessage}}" wx:if="{{selectedMessage.type === 'user' && !selectedMessage.isRevoked}}">
      <text class="fa fa-undo"></text>
      <text>撤回</text>
    </view>
    <view class="action-item" bindtap="deleteMessage" data-message="{{selectedMessage}}">
      <text class="fa fa-trash"></text>
      <text>删除</text>
    </view>
  </view>
  <!-- 输入区域 -->
  <view class="input-area">
    <view class="input-container">
      <view class="plus-btn" id="plusBtn" bindtap="showPlusMenu">
        <text class="fa fa-plus"></text>
      </view>
      <input type="text" class="input-field" id="messageInput" placeholder="输入消息..." value="{{inputValue}}" bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur" bindconfirm="sendMessage"></input>
      <view class="send-btn" id="sendBtn" bindtap="sendMessage">
        <text class="fa fa-paper-plane"></text>
      </view>
      <!-- <view class="hold-to-talk-btn" id="holdToTalkBtn" wx:else bindtouchstart="onHoldToTalkStart" bindtouchend="onHoldToTalkEnd" bindtouchcancel="onHoldToTalkCancel">
        <text class="fa fa-microphone"></text>
        <text>按住说话</text>
      </view> -->
    </view>
  </view>
  <!-- 功能菜单 -->
  <view class="function-menu {{showFunctionMenu ? 'show' : ''}}" wx:if="{{showFunctionMenu}}">
    <view class="function-grid">
      <view class="function-item" bindtap="onFunctionItemClick" data-type="image">
        <view class="function-icon image">
          <i class="fa fa-image"></i>
        </view>
        <view class="function-label">图片</view>
      </view>
      <view class="function-item" bindtap="onFunctionItemClick" data-type="file">
        <view class="function-icon file">
          <i class="fa fa-file"></i>
        </view>
        <view class="function-label">文件</view>
      </view>
      <view class="function-item" bindtap="onFunctionItemClick" data-type="location">
        <view class="function-icon location">
          <i class="fa fa-map-marker"></i>
        </view>
        <view class="function-label">位置</view>
      </view>
      <view class="function-item" bindtap="onFunctionItemClick" data-type="emoji">
        <view class="function-icon emoji">
          <i class="fa fa-smile-o"></i>
        </view>
        <view class="function-label">表情</view>
      </view>
    </view>
  </view>
  <!-- AI分身悬浮按钮 -->
  <view class="ai-avatar-button {{aiStatus === 'offline' ? 'offline' : ''}}" bindtap="toggleAiMenu">
    <view class="ai-avatar-ripple"></view>
    <view class="ai-avatar-icon">
      <image src="/assets/icons/robot.png"></image>
    </view>
  </view>
  <!-- AI分身开关菜单 -->
  <view class="ai-menu {{showAiMenu ? 'show' : ''}}" wx:if="{{showAiMenu}}">
    <view class="ai-toggle-container">
      <text class="ai-label">{{aiOnline ? 'AI分身已上线' : 'AI分身已下线'}}</text>
      <view class="ai-toggle-switch">
        <switch class="ai-toggle-input" checked="{{aiOnline}}" bindchange="toggleAiOnline" />
        <!-- <view class="ai-toggle-slider"></view> -->
      </view>
    </view>
  </view>
</view>