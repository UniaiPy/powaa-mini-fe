<!-- subpages/ai-report/ai-report.wxml -->
<view class="page-container">
  <!-- 顶部导航 -->
  <!-- <view class="fixed-nav flex items-center justify-between py-3 px-6 text-black">
    <view class="flex items-center gap-3">
      <view class="cursor-pointer" bindtap="goBack">
        <i class="fas fa-chevron-left text-black"></i>
      </view>
    </view>
    <view class="text-xl font-bold text-gray-900">我的AI报告</view>
    <view class="w-8 h-8"></view>
  </view> -->
  <!-- 主内容 -->
  <view class="content-with-fixed-nav flex-1 content-card rounded-t-3xl px-4 py-3 space-y-3">
    <view class="bg-white rounded-lg overflow-hidden shadow-sm">
      <!-- 头像和昵称 -->
      <view class="text-center py-3">
        <view class="w-16 h-16 rounded-full overflow-hidden mx-auto mb-2">
          <image src="{{userInfo.avatar}}" mode="aspectFill" class="w-full h-full"></image>
        </view>
        <view class="text-base font-medium text-gray-900">{{userInfo.nickname}}</view>
      </view>
      <!-- AI分身分析 -->
      <view class="bg-white p-4 fade-in-up">
        <!-- AI分身说明 -->
        <view class="mb-6">
          <view class="text-sm font-medium text-gray-700 mb-3">AI分身说明</view>
          <view class="text-xs text-gray-700">
            <view>{{reportSummary}}</view>
          </view>
        </view>
        <!-- 人格画像 -->
        <view class="mb-6">
          <view class="text-sm font-medium text-gray-700 mb-3">人格画像</view>
          <view class="radar-container">
            <canvas type="2d" id="personalityRadar" class="w-full" style="width:634px;height: 280px;"></canvas>
          </view>
        </view>
        <!-- 画像解读 -->
        <view class="mb-0">
          <view class="text-sm font-medium text-gray-700 mb-3">画像解读</view>
          <view class="mb-0">
            <block wx:if="{{reportData && reportData.personality_traits && reportData.personality_traits.length > 0}}">
              <view wx:for="{{reportData.personality_traits}}" wx:key="index" class="text-xs text-gray-700 mb-2">
                {{item.name}}:
                <text class="font-medium">{{item.score || 0}}分</text>
                - {{item.description || 'AI分析中...'}}
              </view>
            </block>
            <block wx:else>
              <view class="text-xs text-gray-700 mb-2">开放性: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">尽责性: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">外向性: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">亲和性: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">情绪稳定性: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">参与度: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">社交动机: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-2">质量导向: 50分 - AI分析中...</view>
              <view class="text-xs text-gray-700 mb-0">情感共鸣: 50分 - AI分析中...</view>
            </block>
          </view>
        </view>
      </view>
      <!-- 分析来源 -->
      <view class="bg-white p-4 fade-in-up">
        <view class="text-sm font-medium text-gray-700 mb-3">分析来源</view>
        <view class="text-xs text-gray-700 mb-0">
          <view class="mb-2">1. 通过分析您与AI分身的深度对话内容，识别您的思维模式、表达习惯和情感倾向</view>
          <view class="mb-2">2. 结合您填写的个人资料，分析您的自我认知和对外形象</view>
          <view class="mb-2">3. 分析您与其他用户的交流模式，了解您的社交风格和互动偏好</view>
          <view class="mb-0">4. 基于您已连接的人的信息和关系网络，评估您的社交圈层和影响力范围</view>
        </view>
      </view>
      <!-- 报告说明 -->
      <view class="bg-white p-4 fade-in-up text-center">
        <view class="text-xs text-gray-700 mb-2">将作为AI分身对外聊天时的主要依据</view>
        <view class="text-xs text-gray-700 mb-0">
          生成时间：
          <text>{{reportTime}}</text>
        </view>
      </view>
      <!-- 底部版权信息 -->
      <view class="text-center text-gray-400 text-xs py-4 mb-20">小瓦AI分身 © 2025</view>
    </view>
  </view>
  <!-- 底部导航栏组件 -->
  <!-- <bottom-nav unread-count="{{unreadCount}}" /> -->
</view>