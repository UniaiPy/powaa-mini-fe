/* components/bottom-nav/bottom-nav.wxss */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 1rpx solid #e5e7eb;
  z-index: 40;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.nav-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9ca3af;
  font-size: 20rpx;
  transition: all 0.3s ease;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  position: relative;
}

.nav-item:active {
  color: #8b5cf6;
  background-color: #f3f4f6;
}

.nav-item text:first-child {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.nav-item text:last-child {
  font-weight: 500;
}

.nav-badge {
  position: absolute;
  top: 4rpx;
  right: 16rpx;
  background: #ef4444;
  color: white;
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 16rpx;
  min-width: 24rpx;
  height: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  z-index: 10;
}