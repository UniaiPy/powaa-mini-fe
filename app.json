{  "pages": [    "pages/login/login",    "pages/chat/chat",    "pages/avatar/avatar",    "pages/profile/profile"  ],  "subpackages": [    {
      "root": "subpages",
      "pages": [
        "conversation/conversation",
        "share/share",
        "preview/preview",
        "about/about",
        "ai-report/ai-report",
        "search/search"
      ]
    }
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "小瓦AI分身",
    "navigationBarTextStyle": "black",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#9ca3af",
    "selectedColor": "#8b5cf6",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/chat/chat",
        "text": "聊天",
        "iconPath": "assets/icons/chat.png",
        "selectedIconPath": "assets/icons/chat-active.png"
      },
      {
        "pagePath": "pages/avatar/avatar",
        "text": "AI分身",
        "iconPath": "assets/icons/robot.png",
        "selectedIconPath": "assets/icons/robot-active.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "名片",
        "iconPath": "assets/icons/card.png",
        "selectedIconPath": "assets/icons/card-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "renderer": "webview",
  "requiredPrivateInfos": ["chooseLocation"],
  "permission": {
    "scope.userLocation": {
      "desc": "您的位置信息将用于选择地点"
    }
  }
}